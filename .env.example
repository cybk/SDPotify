# Copia este archivo a ".env" y llena tus valores.

# Mismas credenciales que usaste para el MCP de Spotify
# (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback
# Si es relativa, se resuelve contra la carpeta del proyecto.
SPOTIFY_CACHE_PATH=.spotify_token_cache

# Token compartido que protege el daemon. Genera uno único con:
#   python -c "import secrets; print(secrets.token_hex(16))"
# y pega el resultado aquí. Usa este MISMO valor en scripts/_config.py
# (o como variable de entorno DAEMON_TOKEN al ejecutar los scripts).
DAEMON_TOKEN=
